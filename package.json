{
  "name": "@geekplux/vert",
  "version": "0.2.0",
  "description": "3D terrain of a GPX run for a React page: a scene viewer, an elevation profile, and an offline bake that keeps coordinates out of the browser.",
  "license": "MIT",
  "author": "Sean G",
  "homepage": "https://vert.geekplux.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekplux/vert.git"
  },
  "bugs": "https://github.com/geekplux/vert/issues",
  "keywords": [
    "gpx",
    "terrain",
    "elevation",
    "three.js",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./vert.css": "./dist-lib/vert.css",
    "./fixtures/*": "./dist-lib/fixtures/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "vert-bake": "dist-lib/bake.js"
  },
  "files": [
    "dist-lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@8.6.10",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && vite build -c vite.bake.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "sample": "node scripts/make-sample.mjs",
    "bake": "node scripts/bake.ts",
    "fixtures": "node scripts/fetch-courses.mjs",
    "posters": "node scripts/capture-posters.mjs",
    "stories": "ladle serve",
    "stories:build": "ladle build",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:types": "wrangler types --config worker/wrangler.toml worker/worker-configuration.d.ts",
    "prepublishOnly": "pnpm build:lib && node -e \"if (/dirty|nogit/.test(require('fs').readFileSync('dist-lib/VERSION', 'utf8'))) { console.error('dist-lib/VERSION: publish from a clean, committed checkout'); process.exit(1); }\""
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
