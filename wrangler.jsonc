// Vert as ONE Worker: the app's static assets from dist/, and /tiles/* to the tile proxy in
// worker/src, with tiles cached in R2 (bucket vert-tiles). Workers Builds deploys it on every push to
// main, and builds a Preview (`wrangler preview`) for every other branch. Details: worker/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vert",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only tile requests run Worker code; everything else is a static asset (or the SPA shell).
    "run_worker_first": ["/tiles/*"],
  },
  "r2_buckets": [{ "binding": "TILES", "bucket_name": "vert-tiles" }],
  // Abuse limits for the public tile proxy (worker/src/proxy.ts). TILE_LIMIT: tile requests per
  // client IP per minute. STORE_LIMIT: new tiles written to R2 per minute for the whole site; past
  // it, tiles are streamed from upstream without being stored. Counts are per Cloudflare location
  // and approximate. namespace_id must be unique in the account.
  "ratelimits": [
    { "name": "TILE_LIMIT", "namespace_id": "3001", "simple": { "limit": 600, "period": 60 } },
    { "name": "STORE_LIMIT", "namespace_id": "3002", "simple": { "limit": 300, "period": 60 } },
  ],
  // Branch Previews get their own tile cache, so a preview never writes into production's.
  "previews": {
    "r2_buckets": [{ "binding": "TILES", "bucket_name": "vert-tiles-preview" }],
    "ratelimits": [
      { "name": "TILE_LIMIT", "namespace_id": "3101", "simple": { "limit": 600, "period": 60 } },
      { "name": "STORE_LIMIT", "namespace_id": "3102", "simple": { "limit": 300, "period": 60 } },
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Privacy: keep only the Worker's own structured logs (zoom, source, status). Invocation logs
    // record request metadata (headers, the cf object), which the proxy must not keep.
    "logs": { "enabled": true, "invocation_logs": false },
    "redact_query_string": true,
  },
}
